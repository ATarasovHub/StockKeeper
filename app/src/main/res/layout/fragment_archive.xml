<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundMode="outline" app:startIconDrawable="@android:drawable/ic_menu_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/archiveSearchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_hint" android:inputType="text" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/archiveList" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/archiveEmptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/archive_empty_title" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/archive_empty_message" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
